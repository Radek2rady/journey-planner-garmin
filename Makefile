# Developer commands. Run `make help` for the list.

DEVICE        ?= fr955
# Private key that signs the builds; generate one with the VS Code command
# "Monkey C: Generate a Developer Key". Never commit it.
DEVELOPER_KEY ?= $(HOME)/Documents/garmin-key/developer_key
# Path of the active SDK, as selected in the Connect IQ SDK Manager.
SDK_HOME      ?= $(shell cat "$(HOME)/Library/Application Support/Garmin/ConnectIQ/current-sdk.cfg" 2>/dev/null)

# Address and key of the hosted proxy for `make release`. Set them in `local.mk`
# (not committed); see docs/DEPLOY.md.
-include local.mk
DEV_PROXY_URL ?= http://localhost:8787
PROXY_URL     ?=
PROXY_KEY     ?=

OUT      := bin
# One debug build per device, so that `make run DEVICE=...` never runs another device's build.
APP      := $(OUT)/Transit-$(DEVICE).prg
TEST_APP := $(OUT)/Transit-test.prg
BUILD_CONFIG := source/BuildConfig.mc
APP_VERSION  := $(shell sed -n 's/.*<iq:application .* version="\([^"]*\)".*/\1/p' manifest.xml)
SOURCES  := $(shell find source resources resources-ces resources-icon-* -type f ! -path $(BUILD_CONFIG)) manifest.xml monkey.jungle
MONKEYC   = "$(SDK_HOME)bin/monkeyc" -f monkey.jungle -d $(DEVICE) -y "$(DEVELOPER_KEY)" -w

# Writes $(BUILD_CONFIG) with the proxy address $(1), key $(2) and the app version.
define write_build_config
	@printf '// Generated by the Makefile. Do not edit, do not commit.\nmodule BuildConfig {\n    const PROXY_URL = "%s";\n    const PROXY_KEY = "%s";\n    const APP_VERSION = "%s";\n}\n' '$(1)' '$(2)' '$(APP_VERSION)' > $(BUILD_CONFIG)
endef

.PHONY: help build release run simulator proxy test test-proxy test-watch clean

help: ## List the commands
	@grep -E '^[a-z-]+:.*##' $(MAKEFILE_LIST) | sed -E 's/:.*## /\t/' | expand -t 14

build: $(APP) ## Debug build for the simulator

$(APP): $(SOURCES)
	@mkdir -p $(OUT)
	$(call write_build_config,$(DEV_PROXY_URL),)
	$(MONKEYC) -o $@

release: ## Optimized build for the watch; needs PROXY_URL in local.mk
	@case "$(PROXY_URL)" in https://*) ;; *) echo "Set PROXY_URL=https://... in local.mk (docs/DEPLOY.md)"; exit 1;; esac
	@mkdir -p $(OUT)
	$(call write_build_config,$(PROXY_URL),$(PROXY_KEY))
	$(MONKEYC) -r -O 2 -o $(OUT)/Transit-release.prg
	$(call write_build_config,$(DEV_PROXY_URL),)
	@echo "Copy $(OUT)/Transit-release.prg to GARMIN/APPS on the watch"

simulator: ## Start the Connect IQ simulator
	"$(SDK_HOME)bin/connectiq"

run: build ## Run the app in the simulator (start `make simulator` and `make proxy` first)
	"$(SDK_HOME)bin/monkeydo" $(APP) $(DEVICE)

proxy: ## Run the proxy on http://127.0.0.1:8787
	python3 proxy/transit_proxy.py

test: test-proxy test-watch ## Run all tests

test-proxy: ## Unit tests of the proxy
	python3 -m unittest discover -s proxy

test-watch: ## Unit tests of the watch app (needs `make simulator`)
	@mkdir -p $(OUT)
	$(call write_build_config,$(DEV_PROXY_URL),)
	$(MONKEYC) -t -o $(TEST_APP)
	@# monkeydo exits with 1 even when all tests pass, so the result is read
	@# from its output instead.
	@"$(SDK_HOME)bin/monkeydo" $(TEST_APP) $(DEVICE) -t | tee $(OUT)/test-watch.log; \
		grep -q '^PASSED' $(OUT)/test-watch.log

clean: ## Remove build output
	rm -rf $(OUT) proxy/__pycache__
